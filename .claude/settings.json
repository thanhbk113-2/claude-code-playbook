{
  "maxEffortLevel": "medium",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash",
      "Read",
      "Write(C:/Users/thanh-win10/**)",
      "Edit(C:/Users/thanh-win10/**)",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch"
    ],
    "ask": [
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(del:*)",
      "Bash(rd:*)",
      "Bash(Remove-Item:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)"
    ]
  },
  "env": {
    "ANTHROPIC_BASE_URL": "http://localhost:20128",
    "ANTHROPIC_AUTH_TOKEN": "omniroute",
    "ANTHROPIC_MODEL": "antigravity-combo",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "antigravity-combo",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "antigravity-combo",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "antigravity-combo",
    "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "131072",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File hooks/security-guard.ps1",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
